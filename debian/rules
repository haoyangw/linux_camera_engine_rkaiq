#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
#DH_VERBOSE = 1

# see EXAMPLES in dpkg-buildflags(1) and read /usr/share/dpkg/*
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/default.mk

# Set architecture variables
DPKG_EXPORT_BUILDFLAGS := 1
include /usr/share/dpkg/architecture.mk

# Include SoC-specific configurations
include debian/targets.mk

# see FEATURE AREAS in dpkg-buildflags(1)
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# see ENVIRONMENT in dpkg-buildflags(1)
# package maintainers to append CFLAGS
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
# package maintainers to append LDFLAGS
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

ifneq ($(DEB_HOST_GNU_TYPE),$(DEB_BUILD_GNU_TYPE))
	export CMAKE_TOOLCHAIN_FILE=/etc/dpkg-cross/cmake/CMakeCross.txt
endif

# main packaging script based on dh7 syntax
%:
	dh $@ --parallel --with systemd 

# debmake generated override targets
# This is example for Cmake (See http://bugs.debian.org/641051 )
override_dh_auto_clean:
	dh_auto_clean
	rm -rf debian/build
	rm -rf debian/tmp

override_dh_auto_configure:
	$(foreach rkaiq_platform,$(rkaiq_platforms), \
		mkdir -p debian/build/$(rkaiq_platform) && \
		mkdir -p debian/tmp/camera-engine-rkaiq-$(rkaiq_platform) && \
		dh_auto_configure --builddirectory=debian/build/$(rkaiq_platform) -- \
			-G Ninja \
			-DCMAKE_INSTALL_PREFIX=/usr \
			-DCMAKE_BUILD_TYPE=RelWithDebInfo \
			-DARCH=$(DEB_HOST_GNU_CPU) \
			-DRKAIQ_BUILD_BINARY_IQ=ON \
			-DCMAKE_SKIP_RPATH=TRUE \
			-DCMAKE_EXPORT_COMPILE_COMMANDS=YES \
			-DRKAIQ_USE_RAWSTREAM_LIB=OFF \
			-DRKAIQ_HAVE_FAKECAM=ON \
			-DRKAIQ_ENABLE_AF=ON \
			-DDEB_DESTDIR=$(CURDIR)/debian/tmp/camera-engine-rkaiq-$(rkaiq_platform) \
			$($(rkaiq_platform)_config) &&) true

override_dh_auto_build:
	@for rkaiq_platform in $(rkaiq_platforms); do \
		dh_auto_build --builddir=debian/build/$$rkaiq_platform; \
	done

override_dh_auto_install:
	@for rkaiq_platform in $(rkaiq_platforms); do \
		dh_auto_install --builddir=debian/build/$$rkaiq_platform \
			--destdir=debian/tmp/camera-engine-rkaiq-$$rkaiq_platform; \
	done

override_dh_auto_test:
override_dh_installdocs:
